    {
      "name": "Full Pipeline API - /api/v1",
      "item": [
        {
          "name": "Analyze Alert - CPU",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"payment-service\",\n  \"alert_type\": \"CPUUtilization\",\n  \"metrics\": {\n    \"cpu_percent\": 93.0,\n    \"error_rate\": 0.03,\n    \"latency_p99_ms\": 4500\n  },\n  \"logs_snippet\": \"ERROR: Thread pool exhausted. Queue size: 512.\",\n  \"severity\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/incidents/analyze",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "incidents", "analyze"]
            }
          }
        },
        {
          "name": "Analyze Alert - DB Connections",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"order-service\",\n  \"alert_type\": \"DatabaseConnections\",\n  \"metrics\": {\n    \"cpu_percent\": 28.0,\n    \"error_rate\": 0.45,\n    \"db_connections\": 198,\n    \"db_max_connections\": 200\n  },\n  \"logs_snippet\": \"ERROR: HikariPool-1 Connection not available, timed out after 30000ms\",\n  \"severity\": \"CRITICAL\",\n  \"log_source\": \"java\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/incidents/analyze",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "incidents", "analyze"]
            }
          }
        },
        {
          "name": "Analyze Alert - Magento Checkout",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"magento-checkout\",\n  \"alert_type\": \"LogAnomaly\",\n  \"metrics\": {\n    \"error_rate\": 0.32,\n    \"latency_p99_ms\": 6200\n  },\n  \"logs_snippet\": \"main.CRITICAL: Payment gateway timeout while placing order. SQLSTATE lock wait timeout exceeded.\",\n  \"severity\": \"HIGH\",\n  \"log_source\": \"magento\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/incidents/analyze",
              "host": ["{{base_url}}"],
              "path": ["{{api_prefix}}", "incidents", "analyze"]
            }
          }
        },

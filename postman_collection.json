    {
      "name": "Magento Logs Dedicated Lambda",
      "item": [
        {
          "name": "AWS Generate Magento Logs",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_events\": 100,\n  \"fail_percent\": 20,\n  \"trigger_incidents\": true,\n  \"max_incidents\": 3\n}"
            },
            "url": {
              "raw": "{{aws_base_url}}/magento/logs/generate",
              "host": ["{{aws_base_url}}"],
              "path": ["magento", "logs", "generate"]
            },
            "description": "Dedicated API Gateway route backed by ai-ops-mvp-dev-magento-logs-generator. Run Terraform apply first."
          }
        },

# ══════════════════════════════════════════════════════
#  Agentic Support Framework — .env for local POC
#  Copy this file:  cp .env.example .env
# ══════════════════════════════════════════════════════

# ── App mode ─────────────────────────────────────────
# "mock"  → built-in mock LLM. No Ollama needed for first run.
# "live"  → uses real Ollama (run: ollama pull llama3.2 first)
APP_MODE=mock
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── LLM (only needed when APP_MODE=live) ─────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embeddings ────────────────────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DEVICE=cpu

# ── Vector store ──────────────────────────────────────
VECTOR_STORE=faiss
FAISS_INDEX_PATH=./data/faiss_index
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# ── Log sources ───────────────────────────────────────
# POC: PYTHON_LOG_PATH points at the sample app's log.
# Change to an absolute path if uvicorn runs from a different directory.
PYTHON_LOG_PATH=./sample_app/logs/app.log
MAGENTO_LOG_PATH=disabled
MAGENTO_EXCEPTION_LOG_PATH=./sample_logs/magento/exception.log
MAGENTO_SYSTEM_LOG_PATH=./sample_logs/magento/system.log
MAGENTO_ACCESS_LOG_PATH=./sample_logs/magento/access.log
MAGENTO_FAILURE_THRESHOLD_COUNT=5
MAGENTO_FAILURE_WINDOW_SECONDS=300
MAGENTO_INCIDENT_COOLDOWN_SECONDS=60
AEM_LOG_PATH=disabled
JAVA_LOG_PATH=disabled
LOG_POLL_INTERVAL_SEC=5

# ── Incident persistence ─────────────────────────────────
MONGODB_ENABLED=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agentic_support
MONGODB_INCIDENTS_COLLECTION=incidents

# ── Alerting (leave blank for POC) ───────────────────
SLACK_BOT_TOKEN=
JIRA_BASE_URL=
JIRA_PROJECT_KEY=SRE

# ── AI operational intelligence MVP ─────────────────
# Local mode is safe: no AWS calls and remediation is dry-run only.
USE_AWS=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MAX_TOKENS=1200
BEDROCK_TEMPERATURE=0.1
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=incident-knowledge
S3_BUCKET_NAME=ai-ops-knowledge-mvp
DYNAMODB_INCIDENTS_TABLE=ai-ops-incidents-mvp
DYNAMODB_AUDIT_TABLE=ai-ops-audit-mvp
REMEDIATION_LAMBDA_NAME=ai-ops-mock-remediation-mvp
LOCAL_DATA_DIR=./sample_data
LOCAL_STORE_PATH=./.local/incident_store.json
LOCAL_AUDIT_PATH=./.local/audit_log.jsonl
CONFIDENCE_REVIEW_THRESHOLD=0.75
AUTO_MOCK_CONFIDENCE_THRESHOLD=0.85
